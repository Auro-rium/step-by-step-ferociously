{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(svg|webp|png|jpg|jpeg|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(performance-runtime|real-course-thumbnails|launch-discount|company-shell|legal-consent|why-nav)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/(landing-hero-v2|finish-palette-v3|auth-palette-v2|launch-discount|company-shell|legal-consent|catalog-v3|performance-v1)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }
      ]
    }
  ],
  "routes": [
    { "src": "/why", "dest": "/why.html" },
    { "src": "/why.html", "status": 308, "headers": { "Location": "/why" } },

    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/privacy.html", "status": 308, "headers": { "Location": "/privacy" } },

    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/terms.html", "status": 308, "headers": { "Location": "/terms" } },

    { "src": "/refunds", "dest": "/refund-policy.html" },
    { "src": "/refund-policy", "status": 308, "headers": { "Location": "/refunds" } },
    { "src": "/refund-policy.html", "status": 308, "headers": { "Location": "/refunds" } },

    { "src": "/payments", "dest": "/payments.html" },
    { "src": "/payments.html", "status": 308, "headers": { "Location": "/payments" } },

    { "src": "/cookies", "dest": "/cookies.html" },
    { "src": "/cookies.html", "status": 308, "headers": { "Location": "/cookies" } },

    { "src": "/acceptable-use", "dest": "/acceptable-use.html" },
    { "src": "/acceptable-use.html", "status": 308, "headers": { "Location": "/acceptable-use" } },

    { "src": "/content-copyright", "dest": "/content-copyright.html" },
    { "src": "/content-copyright.html", "status": 308, "headers": { "Location": "/content-copyright" } },

    { "handle": "filesystem" },
    {
      "src": "/.*",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    }
  ]
}
